	<!-- VVE_Scytheman: stock HSKV_Turret_MRL130 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="VVE_Scytheman"]/comps/li[@Class="Vehicles.CompProperties_VehicleTurrets"]/turrets/li[key="mainTurret"]/turretDef</xpath>
		<value>
