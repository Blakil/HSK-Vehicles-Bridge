	<Operation Class="PatchOperationReplace">
		<xpath>Defs/Vehicles.VehicleDef[defName="VVE_Bulldog"]/comps/li[@Class="Vehicles.CompProperties_VehicleTurrets"]/turrets/li[key="mainTurret"]/turretDef</xpath>
		<value>
