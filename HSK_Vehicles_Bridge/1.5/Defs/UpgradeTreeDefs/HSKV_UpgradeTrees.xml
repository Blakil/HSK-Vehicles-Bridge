	<!-- VVE_Scytheman: modules Mortar81 -->
	<Vehicles.UpgradeTreeDef>
		<defName>HSKV_VVE_Scytheman_UpgradeTree</defName>
		<nodes>
			<li>
				<key>HSKV_SC_Mortar81</key>
				<label>Mortar 81 mm</label>
				<description>Indirect fire over walls and hills. Accurate with a spotter, a gamble without one.</description>
				<icon>HSKV/Parts/HSKV_Mount_Mortar</icon>
				<work>1200</work>
				<gridCoordinate>(6, 7)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				<researchPrerequisites>
					<li>VVE_CombatVehicles</li>
					<li>Mortars</li>
				</researchPrerequisites>
				<upgrades>
					<li Class="Vehicles.TurretUpgrade">
						<turrets>
							<li>
								<turretDef>HSKV_Turret_Mortar81</turretDef>
								<renderProperties>
									<north>(0, -1)</north>
									<south>(0, 1.9)</south>
									<east>(-1.55, 0.53)</east>
								</renderProperties>
								<gizmoLabel>Mortar81</gizmoLabel>
								<defaultAngleRotated>180</defaultAngleRotated>
								<angleRestricted/>
								<aimPieOffset>(0, 0.1)</aimPieOffset>
								<autoTargeting>false</autoTargeting>
								<key>mainTurret</key>
							</li>
						</turrets>
						<removeTurrets>
							<li>mainTurret</li>
						</removeTurrets>
