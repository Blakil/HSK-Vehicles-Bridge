						<li>ShortBarrel</li>
					</disableIfUpgradeNodesEnabled>
					<upgrades>
						<li Class="Vehicles.TurretUpgrade">
							<turrets>
								<li>
									<turretDef>HSKV_Turret_AC20</turretDef>
									<renderProperties>
										<north>(-0.05, 0.2)</north>
										<south>(-0.02, 0.2)</south>
										<east>(-0.02, 0.4)</east>
									</renderProperties>
									<gizmoLabel>AC20</gizmoLabel>
									<angleRestricted/>
									<aimPieOffset>(0, 0.65)</aimPieOffset>
									<key>mainTurret</key>
								</li>
							</turrets>
							<removeTurrets>
								<li>mainTurret</li>
