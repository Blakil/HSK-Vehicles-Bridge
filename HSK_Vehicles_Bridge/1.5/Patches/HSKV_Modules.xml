			<value>
				<li>
					<key>HSKV_BN_AC20</key>
					<label>Autocannon 20×102</label>
					<description>A 20 mm autocannon: fast, flat-shooting, shreds infantry and light vehicles and wears down armoured cars.</description>
					<icon>HSKV/Parts/HSKV_Mount_Autocannon</icon>
					<work>1500</work>
					<gridCoordinate>(6, 23)</gridCoordinate>
					<drawSize>(80, 80)</drawSize>
					<researchPrerequisites>
						<li>HSKV_ArmoredVehicles2</li>
