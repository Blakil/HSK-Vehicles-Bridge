<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- HSK Vehicles Bridge: costs, research and recipes of Simply Bicycle / Wheel Barrow vehicles, adapted to the HSK balance progression. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]</xpath>
		<match Class="PatchOperationConditional">
			<xpath>Defs/ThingDef[defName="Wheel_Wood"]</xpath>
			<match Class="PatchOperationConditional">
				<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases/MarketValue</xpath>
				<match Class="PatchOperationReplace">
					<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases/MarketValue</xpath>
					<value><MarketValue>100</MarketValue></value>
				</match>
				<nomatch Class="PatchOperationConditional">
					<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases</xpath>
					<match Class="PatchOperationAdd">
						<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases</xpath>
						<value><MarketValue>100</MarketValue></value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]</xpath>
						<value><statBases><MarketValue>100</MarketValue></statBases></value>
					</nomatch>
				</nomatch>
			</match>
			<nomatch Class="PatchOperationConditional">
				<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases/MarketValue</xpath>
				<match Class="PatchOperationReplace">
					<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases/MarketValue</xpath>
					<value><MarketValue>300</MarketValue></value>
				</match>
				<nomatch Class="PatchOperationConditional">
					<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases</xpath>
					<match Class="PatchOperationAdd">
						<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]/statBases</xpath>
						<value><MarketValue>300</MarketValue></value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/Vehicles.VehicleDef[defName="MWB_WheelBarrow"]</xpath>
						<value><statBases><MarketValue>300</MarketValue></statBases></value>
					</nomatch>
				</nomatch>
			</nomatch>
		</match>
	</Operation>

