			<xpath>Defs/Vehicles.UpgradeTreeDef[defName="BP_Lemanruss_UpgradeTree"]/nodes/li[key="TurretSpikes"]/ingredients</xpath>
			<value><ingredients><Plasteel>50</Plasteel><HP_Ceramite>40</HP_Ceramite><GW_ChaosSpikes>7</GW_ChaosSpikes></ingredients></value>
		</match>
	</Operation>
