<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- HSK Vehicles Bridge: costs, research and recipes of Sabbat's Blight upgrades vehicles, adapted to the HSK balance progression. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.UpgradeTreeDef[defName="BP_Lemanruss_UpgradeTree"]/nodes/li[key="DozerBlade"]/ingredients</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.UpgradeTreeDef[defName="BP_Lemanruss_UpgradeTree"]/nodes/li[key="DozerBlade"]/ingredients</xpath>
			<value><ingredients><Plasteel>75</Plasteel><HP_Ceramite>40</HP_Ceramite><ComponentIndustrial>2</ComponentIndustrial></ingredients></value>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.UpgradeTreeDef[defName="BP_Lemanruss_UpgradeTree"]/nodes/li[key="TurretSpikes"]/ingredients</xpath>
