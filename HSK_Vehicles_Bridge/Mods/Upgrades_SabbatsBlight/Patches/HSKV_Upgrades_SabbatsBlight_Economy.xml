		<match Class="PatchOperationConditional">
			<xpath>Defs/ThingDef[defName="GW_VehicleSideTurret"]</xpath>
			<match Class="PatchOperationReplace">
				<xpath>Defs/Vehicles.UpgradeTreeDef[defName="BP_Taurox_UpgradeTree"]/nodes/li[key="PintleStubberUpgrade"]/ingredients</xpath>
				<value><ingredients><Plasteel>100</Plasteel><GW_VehicleSideTurret>1</GW_VehicleSideTurret><HP_Ceramite>40</HP_Ceramite><ComponentIndustrial>2</ComponentIndustrial></ingredients></value>
			</match>
			<nomatch Class="PatchOperationReplace">
				<xpath>Defs/Vehicles.UpgradeTreeDef[defName="BP_Taurox_UpgradeTree"]/nodes/li[key="PintleStubberUpgrade"]/ingredients</xpath>
				<value><ingredients><Plasteel>100</Plasteel><HP_Ceramite>40</HP_Ceramite><ComponentIndustrial>2</ComponentIndustrial></ingredients></value>
			</nomatch>
		</match>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.UpgradeTreeDef[defName="BP_Taurox_UpgradeTree"]/nodes/li[key="PintleStormBolterUpgrade"]/ingredients</xpath>
		<match Class="PatchOperationConditional">
			<xpath>Defs/ThingDef[defName="GW_VehicleSideTurret"]</xpath>
