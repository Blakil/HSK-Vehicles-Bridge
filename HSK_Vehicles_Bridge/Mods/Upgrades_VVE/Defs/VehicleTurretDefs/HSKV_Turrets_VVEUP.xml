<Defs>

	<!-- HSK Vehicles Bridge: turrets of VVE Upgrades nodes, adapted to the HSK weapon scale. -->

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>HSKV_Turret_Cannon90_Long</defName>
		<label>90 mm tank gun, long barrel</label>
		<description>A 90 mm tank gun. HEAT shells defeat any armour short of a main battle tank's front; HE clears infantry and fortifications.</description>
		<turretType>Rotatable</turretType>
		<shotSound>VVE_Shot_RoadkillCannonSound</shotSound>
		<reloadSound>VVE_RoadkillReloadSound</reloadSound>
		<projectile>Bullet_90mmCannonShell_HE</projectile>
		<reloadTimer>8.2</reloadTimer>
		<warmUpTimer>3.5</warmUpTimer>
		<chargePerAmmoCount>1</chargePerAmmoCount>
		<magazineCapacity>1</magazineCapacity>
		<genericAmmo>false</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>0.9</rotationSpeed>
		<projectileOffset>2.5</projectileOffset>
		<maxRange>100</maxRange>
		<minRange>5</minRange>
		<recoil>
			<distanceTotal>0.45</distanceTotal>
			<distancePerTick>0.15</distancePerTick>
			<speedMultiplierPostRecoil>0.35</speedMultiplierPostRecoil>
		</recoil>
		<restrictionType>Vehicles.TurretRestrictions_Stationary</restrictionType>
		<vehicleRecoil>
			<distanceTotal>0.1</distanceTotal>
			<distancePerTick>0.05</distancePerTick>
			<speedMultiplierPostRecoil>0.55</speedMultiplierPostRecoil>
		</vehicleRecoil>
		<motes>
			<li>
				<cycles>1</cycles>
				<moteDef>Mote_CannonPlume</moteDef>
				<animationType>Reset</animationType>
			</li>
		</motes>
		<attachProjectileFlag>VVE_Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>1</ticksBetweenShots>
				<ticksBetweenBursts>1</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
		</fireModes>
		<graphicData>
			<texPath>Upgrades/Roadkill/Tier1_Tank_UpgradeLong_CannonTop</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(4, 4)</drawSize>
		</graphicData>
		<ammunition>
			<thingDefs>
				<li>Ammo_90mmCannonShell_HE</li>
			</thingDefs>
		</ammunition>
		<modExtensions>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_90mmCannonShell</ammoSet>
				<shotHeight>2.5</shotHeight>
				<speed>155</speed>
				<sway>0.82</sway>
				<spread>0.0201</spread>
			</li>
			<li Class="VehiclesCEOverhaul.TurretAimExtension">
				<sightsEfficiency>1.5</sightsEfficiency>
				<recoilAmount>0</recoilAmount>
			</li>
		</modExtensions>
	</Vehicles.VehicleTurretDef>

