	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.UpgradeTreeDef[defName="SEX_TitanChopper_UpgradeTree"]/nodes/li[key="SEX_PassengerCabin"]/ingredients</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.UpgradeTreeDef[defName="SEX_TitanChopper_UpgradeTree"]/nodes/li[key="SEX_PassengerCabin"]/ingredients</xpath>
			<value><ingredients><ComponentIndustrial>8</ComponentIndustrial><HSKV_AnySturdyMetal>320</HSKV_AnySturdyMetal><Cloth>480</Cloth></ingredients></value>
		</match>
	</Operation>

