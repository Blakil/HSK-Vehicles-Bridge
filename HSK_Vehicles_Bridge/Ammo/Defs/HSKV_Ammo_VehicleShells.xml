		<defName>HSKV_AmmoSet_155mmHowitzerShell</defName>
		<label>155mm howitzer shells</label>
		<ammoTypes>
			<Ammo_155mmHowitzerShell_Incendiary>Bullet_155mmHowitzerShell_Incendiary</Ammo_155mmHowitzerShell_Incendiary>
			<Ammo_155mmHowitzerShell_Smoke>Bullet_155mmHowitzerShell_Smoke</Ammo_155mmHowitzerShell_Smoke>
		</ammoTypes>
		<modExtensions>
			<li Class="VehiclesCEOverhaul.VehicleAmmoSetExtension">
				<replaces>AmmoSet_155mmHowitzerShell</replaces>
			</li>
		</modExtensions>
	</CombatExtended.AmmoSetDef>

	<!-- HSKV_AmmoSet_155mmHowitzerShell_directfire: Ammo_155mmHowitzerShell_Incendiary → Bullet_155mmHowitzerShell_Incendiary_directfire, Ammo_155mmHowitzerShell_Smoke → Bullet_155mmHowitzerShell_Smoke_directfire -->
	<CombatExtended.AmmoSetDef>
		<defName>HSKV_AmmoSet_155mmHowitzerShell_directfire</defName>
		<label>155mm howitzer shells (direct fire)</label>
		<ammoTypes>
			<Ammo_155mmHowitzerShell_Incendiary>Bullet_155mmHowitzerShell_Incendiary_directfire</Ammo_155mmHowitzerShell_Incendiary>
			<Ammo_155mmHowitzerShell_Smoke>Bullet_155mmHowitzerShell_Smoke_directfire</Ammo_155mmHowitzerShell_Smoke>
		</ammoTypes>
		<modExtensions>
			<li Class="VehiclesCEOverhaul.VehicleAmmoSetExtension">
				<replaces>AmmoSet_155mmHowitzerShell_directfire</replaces>
			</li>
		</modExtensions>
	</CombatExtended.AmmoSetDef>

	<!-- HSKV_AmmoSet_20x102mm: Ammo_20x102mm_Sabot → Bullet_20x102mm_Sabot -->
