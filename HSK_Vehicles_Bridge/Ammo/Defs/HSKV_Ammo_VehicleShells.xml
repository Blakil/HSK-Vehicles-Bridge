<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- HSK Vehicles Bridge: vehicle ammo, adapted to the HSK ammo progression. -->

	<!-- HSKV_AmmoSet_90mmCannonShell: Ammo_90mmCannonShell_AP → Bullet_90mmCannonShell_AP, Ammo_90mmCannonShell_APCR → Bullet_90mmCannonShell_APCR -->
	<CombatExtended.AmmoSetDef>
		<defName>HSKV_AmmoSet_90mmCannonShell</defName>
		<label>90mm cannon shells</label>
		<ammoTypes>
			<Ammo_90mmCannonShell_AP>Bullet_90mmCannonShell_AP</Ammo_90mmCannonShell_AP>
			<Ammo_90mmCannonShell_APCR>Bullet_90mmCannonShell_APCR</Ammo_90mmCannonShell_APCR>
		</ammoTypes>
		<modExtensions>
			<li Class="VehiclesCEOverhaul.VehicleAmmoSetExtension">
				<replaces>AmmoSet_90mmCannonShell</replaces>
			</li>
		</modExtensions>
	</CombatExtended.AmmoSetDef>

	<!-- HSKV_AmmoSet_155mmHowitzerShell: Ammo_155mmHowitzerShell_Incendiary → Bullet_155mmHowitzerShell_Incendiary, Ammo_155mmHowitzerShell_Smoke → Bullet_155mmHowitzerShell_Smoke -->
