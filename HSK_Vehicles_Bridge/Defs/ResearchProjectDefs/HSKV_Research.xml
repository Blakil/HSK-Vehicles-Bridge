		<researchViewY>11</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>HSKV_CompositeArmor</defName>
		<label>composite armor</label>
		<description>Heavy armour plate of depleted uranium, ceramics and carbon composite for tank fronts.</description>
		<baseCost>5000</baseCost>
		<techLevel>Industrial</techLevel>
		<tab>Vehicles</tab>
		<prerequisites>
			<li>HSKV_ArmoredVehicles2</li>
			<li>HSKV_VehicleArmor</li>
