<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- HSK Vehicles Bridge: vehicle research tree, adapted to the HSK research progression. -->

	<ResearchProjectDef>
		<defName>HSKV_Ships</defName>
		<label>boats</label>
		<description>Motor boats and trawlers; their hulls are sealed vehicle bodies.</description>
		<baseCost>800</baseCost>
		<techLevel>Industrial</techLevel>
		<tab>Vehicles</tab>
		<prerequisites>
			<li>VVE_BasicVehicles</li>
		</prerequisites>
		<researchViewX>1</researchViewX>
		<researchViewY>4</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>HSKV_Trucks</defName>
		<label>trucks</label>
		<description>Trucks and military transports: heavy machines on several wheeled chassis.</description>
		<baseCost>1000</baseCost>
		<techLevel>Industrial</techLevel>
		<tab>Vehicles</tab>
		<prerequisites>
			<li>VVE_BasicVehicles</li>
			<li>Metals_C2</li>
		</prerequisites>
		<researchViewX>1</researchViewX>
		<researchViewY>3</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>HSKV_VehicleArmor</defName>
		<label>armor plates</label>
		<description>Hardened steel armour plate for armoured cars, APCs and the sides of tanks.</description>
		<baseCost>2000</baseCost>
		<techLevel>Industrial</techLevel>
		<tab>Vehicles</tab>
		<prerequisites>
			<li>VVE_CombatVehicles</li>
			<li>Metals_C3</li>
		</prerequisites>
		<researchViewX>2</researchViewX>
		<researchViewY>10</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>HSKV_VehicleWeapons</defName>
		<label>weapon mounts</label>
		<description>Turret mounts that fit HSK weapons to vehicles: light armament (machine guns and flamethrowers), launchers, autocannons and mortars, and fire control systems. The heavier mounts also need the research of their weapon.</description>
		<baseCost>2000</baseCost>
		<techLevel>Industrial</techLevel>
		<tab>Vehicles</tab>
		<prerequisites>
			<li>VVE_CombatVehicles</li>
		</prerequisites>
		<researchViewX>2</researchViewX>
		<researchViewY>12</researchViewY>
	</ResearchProjectDef>

