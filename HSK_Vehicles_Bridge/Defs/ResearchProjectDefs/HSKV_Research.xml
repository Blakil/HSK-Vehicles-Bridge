	<ResearchProjectDef>
		<defName>HSKV_ArmoredVehicles2</defName>
		<label>tracked vehicles</label>
		<description>Tracked running gear: flame tanks and medium tanks. Composite armour and tank guns build on it.</description>
		<baseCost>3000</baseCost>
		<techLevel>Industrial</techLevel>
		<tab>Vehicles</tab>
		<prerequisites>
			<li>VVE_CombatVehicles</li>
