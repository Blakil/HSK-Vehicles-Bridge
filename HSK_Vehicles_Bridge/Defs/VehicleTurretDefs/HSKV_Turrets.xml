<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- HSK Vehicles Bridge turrets, shared by vehicles (the vehicle sets the position on the hull). Graphics from VVE where it fits: Tango belt gun -> .50 BMG, Highwayman twin barrel -> 20x102 autocannon, Toad mortar -> 81 mm, Scytheman rocket pack -> 130 mm; AGL, 7.62 machine gun and 155 mm have their own sprites (painted like the vehicle). CE numbers come from HSK turrets (M2 Browning, Oerlikon, mortar, M800 howitzer), adjusted for a vehicle mount. -->

	<!-- ===== .50 BMG ===== -->
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>HSKV_Turret_HMG50</defName>
		<label>.50 BMG heavy machine gun mount</label>
		<description>A heavy machine gun on a light vehicle turret. Hits harder and further than a rifle-calibre gun and can deal with light armour.</description>
		<turretType>Rotatable</turretType>
		<shotSound>GunShotA</shotSound>
		<projectile>Bullet_50BMG_FMJ</projectile>
		<reloadTimer>8.5</reloadTimer>
		<warmUpTimer>1.5</warmUpTimer>
		<chargePerAmmoCount>1</chargePerAmmoCount>
		<magazineCapacity>100</magazineCapacity>
		<genericAmmo>false</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>1.6</rotationSpeed>
		<projectileOffset>2.1</projectileOffset>
		<maxRange>70</maxRange>
		<recoil>
			<distanceTotal>0.2</distanceTotal>
			<distancePerTick>0.06</distancePerTick>
			<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
		</recoil>
		<attachProjectileFlag>VVE_Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>7</ticksBetweenShots>
				<ticksBetweenBursts>45</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
			<li>
				<shotsPerBurst>6</shotsPerBurst>
				<ticksBetweenShots>7</ticksBetweenShots>
				<ticksBetweenBursts>75</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
		</fireModes>
		<graphicData>
			<texPath>Things/Vehicles/Tier2/Tier2_APC/Tier2_APC_CannonTop</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(4, 4)</drawSize>
		</graphicData>
		<ammunition>
			<thingDefs>
				<li>Ammo_50BMG_FMJ</li>
			</thingDefs>
		</ammunition>
		<modExtensions>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_50BMG</ammoSet>
				<shotHeight>2.0</shotHeight>
