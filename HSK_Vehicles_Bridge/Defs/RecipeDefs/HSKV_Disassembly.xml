<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Generated by Tools/gen_economy.py: disassembly of vehicle parts and VVE car parts (butcherProducts in Economy/<version>/Patches/HSKV_Disassembly.xml). -->

	<RecipeDef>
		<defName>HSKV_DisassembleVehicleParts</defName>
		<label>disassemble vehicle parts</label>
		<description>Take vehicle parts and car parts apart. Each piece that went into a part comes back with a chance equal to the disassembler's vehicle part disassembly efficiency (about half for a skilled crafter): sub-parts whole or not at all, metal as the basic bar of its kind, components.</description>
		<jobString>Disassembling a vehicle part.</jobString>
		<workAmount>1200</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<efficiencyStat>HSKV_VehicleDisassemblyEfficiency</efficiencyStat>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workSkill>Crafting</workSkill>
		<specialProducts>
			<li>Butchery</li>
		</specialProducts>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>HSKV_VehicleParts</li>
					</categories>
					<thingDefs>
						<li>VVE_EngineBlock</li>
						<li>VVE_CarAlternator</li>
						<li>VVE_CarExhaust</li>
						<li>VVE_CarSuspension</li>
						<li>VVE_CarWheel</li>
						<li>VVE_CarBattery</li>
						<li>VVE_CarFuelTank</li>
						<li>VVE_CarTransmission</li>
						<li>VVE_CarRadiator</li>
						<li>VVE_CarWiring</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>HSKV_VehicleParts</li>
			</categories>
			<thingDefs>
				<li>VVE_EngineBlock</li>
				<li>VVE_CarAlternator</li>
				<li>VVE_CarExhaust</li>
				<li>VVE_CarSuspension</li>
				<li>VVE_CarWheel</li>
				<li>VVE_CarBattery</li>
				<li>VVE_CarFuelTank</li>
				<li>VVE_CarTransmission</li>
				<li>VVE_CarRadiator</li>
				<li>VVE_CarWiring</li>
			</thingDefs>
		</fixedIngredientFilter>
		<recipeUsers>
			<li>VVE_GarageBench</li>
		</recipeUsers>
		<researchPrerequisite>VVE_BasicVehicles</researchPrerequisite>
	</RecipeDef>

</Defs>
