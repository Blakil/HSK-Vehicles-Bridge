<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Vehicles CE Overhaul: cargo capacity of Alpha Vehicles: Neolithic vehicles, based on real-world counterparts. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleDef[defName="AV_Wheelbarrow"]/vehicleStats/CargoCapacity</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleDef[defName="AV_Wheelbarrow"]/vehicleStats/CargoCapacity</xpath>
			<value><CargoCapacity>100</CargoCapacity></value>
		</match>
	</Operation>
