<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Vehicles CE Overhaul: 40k energy weapons on stock Combat Extended. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Bullet_Lasgun_Cannon"]/projectile</xpath>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="Bullet_Lasgun_Cannon"]/projectile/damageAmountBase</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="Bullet_Lasgun_Cannon"]/projectile/damageAmountBase</xpath>
						<value>
							<damageAmountBase>80</damageAmountBase>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="Bullet_Lasgun_Cannon"]/projectile</xpath>
						<value>
							<damageAmountBase>80</damageAmountBase>
						</value>
					</nomatch>
				</li>
				<li Class="PatchOperationConditional">
					<xpath>Defs/ThingDef[defName="Bullet_Lasgun_Cannon"]/projectile/armorPenetrationSharp</xpath>
					<match Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="Bullet_Lasgun_Cannon"]/projectile/armorPenetrationSharp</xpath>
						<value>
							<armorPenetrationSharp>1000</armorPenetrationSharp>
						</value>
					</match>
					<nomatch Class="PatchOperationAdd">
						<xpath>Defs/ThingDef[defName="Bullet_Lasgun_Cannon"]/projectile</xpath>
						<value>
							<armorPenetrationSharp>1000</armorPenetrationSharp>
						</value>
					</nomatch>
				</li>
			</operations>
		</match>
	</Operation>

