<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Vehicles CE Overhaul: hull structure of Spacer Vehicles (Titan) vehicles (plates, components, depth, roles) for the CE armor model. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleDef[defName="JASV_Warchief"]/properties/roles/li[key="gunner" and label="Main Cannon Gunner"]/key</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleDef[defName="JASV_Warchief"]/properties/roles/li[key="gunner" and label="Main Cannon Gunner"]/key</xpath>
