<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Vehicles CE Overhaul: hull structure of GrimWorld vehicles (plates, components, depth, roles) for the CE armor model. -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleDef[defName="GW_Baneblade"]/components/li[key="BackArmorPlating"]</xpath>
		<nomatch Class="PatchOperationConditional">
			<xpath>Defs/Vehicles.VehicleDef[defName="GW_Baneblade"]/components</xpath>
			<match Class="PatchOperationAdd">
				<xpath>Defs/Vehicles.VehicleDef[defName="GW_Baneblade"]/components</xpath>
				<value>
					<li>
						<key>BackArmorPlating</key>
						<label>Rear Armor Plating</label>
						<health>1332</health>
						<depth>External</depth>
						<hitbox>
							<side>Back</side>
						</hitbox>
					</li>
				</value>
			</match>
		</nomatch>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleDef[defName="GW_Stormhammer"]/components/li[key="BackArmorPlating"]</xpath>
